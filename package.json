{
  "name": "pricelens",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "pnpm --filter @pricelens/db test:integration && pnpm --filter @pricelens/pipeline test:integration && pnpm --filter @pricelens/api test:integration",
    "test:e2e": "pnpm --filter @pricelens/web test:e2e",
    "ci": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration",
    "docker:up": "docker compose up -d",
    "docker:up:build": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:db": "docker compose up -d postgres",
    "docker:db:down": "docker compose stop postgres",
    "docker:db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @pricelens/db generate",
    "db:migrate": "pnpm --filter @pricelens/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @pricelens/db migrate:deploy",
    "db:seed": "pnpm --filter @pricelens/db seed",
    "db:studio": "pnpm --filter @pricelens/db studio",
    "generate": "pnpm --filter @pricelens/db generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
