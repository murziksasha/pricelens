DATABASE_URL=postgresql://pricelens:pricelens@localhost:5432/pricelens
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme
# Database password used by docker compose (letters and digits only; it goes into DATABASE_URL).
POSTGRES_PASSWORD=
SESSION_TTL_HOURS=168
PORT=3000
# Comma-separated browser origins allowed to call the API cross-origin, e.g. http://192.168.1.10:8080
WEB_ORIGIN=http://localhost:5173
BACKUP_DIR=./backups
BACKUP_KEEP=10
GOOGLE_API_KEY=
GOOGLE_CX=
TELEGRAM_BOT_TOKEN=
# 0 = the worker runs searches (recommended); 1 = run them inside the API process (tests, no worker)
INLINE_SEARCH=0
LAN_ONLY=true
LOGIN_MAX_FAILS=10
